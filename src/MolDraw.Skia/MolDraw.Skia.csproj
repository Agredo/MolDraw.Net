<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(MolDrawTargetFramework)</TargetFramework>
    <PackageId>MolDraw.Skia</PackageId>
    <Description>SkiaSharp 3.119 renderer for 2D chemical structures: crisp element labels, wedges, aromatic styles, light/dark presets, per-atom heat-map highlighting (Viridis, Plasma, Inferno, Magma, Turbo), colour bars, hit testing and PNG/SVG export. Works in MAUI, Avalonia, WPF or server-side .NET — no chemistry toolkit and no UI framework required.</Description>
    <PackageTags>$(PackageTags);renderer;png;svg;colormap;highlight;avalonia;skia</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MolDraw.Depiction\MolDraw.Depiction.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MolDraw.Skia.Tests" />
  </ItemGroup>
</Project>
