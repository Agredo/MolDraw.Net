<Project>

  <!-- Central build settings for all MolDraw.Net projects. -->
  <PropertyGroup>
    <MolDrawTargetFramework>net10.0</MolDrawTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- MAUI / SkiaSharp versions shared with the consumer apps (SkiaSharp must stay on 3.119.x). -->
    <MauiVersion>10.0.130</MauiVersion>
    <MauiWindowsTargetFramework>net10.0-windows10.0.19041.0</MauiWindowsTargetFramework>
    <MauiWindowsMinVersion>10.0.17763.0</MauiWindowsMinVersion>

    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
  </PropertyGroup>

  <!-- Library (packable) projects under src/ -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <IsMolDrawLibrary>true</IsMolDrawLibrary>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>

    <Version>0.3.0</Version>
    <Authors>Agredo Application</Authors>
    <Company>Agredo Application</Company>
    <Product>MolDraw.Net</Product>
    <Copyright>Copyright (c) 2026 Agredo Application</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/Agredo/MolDraw.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Agredo/MolDraw.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>chemistry;cheminformatics;molecule;depiction;structure;smiles;2d;rendering;skiasharp;maui;dotnet;arm64</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/Agredo/MolDraw.Net/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true' or '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsMolDrawLibrary)' != 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsMolDrawLibrary)' == 'true'">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" Condition="Exists('$(MSBuildProjectDirectory)/README.md')" />
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
